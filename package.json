{
  "name": "@prebuilt/node-rdkafka",
  "version": "v3.1.5",
  "description": "Node.js bindings for librdkafka",
  "librdkafka": "2.5.0",
  "main": "lib/index.js",
  "scripts": {
    "configure": "node-gyp configure",
    "build": "node-pre-gyp rebuild",
    "test": "make test",
    "install": "node-pre-gyp install --fallback-to-build",
    "prepack": "node ./ci/prepublish.js",
    "package": "node-pre-gyp package",
    "publish": "node-pre-gyp-github publish --release"
  },
  "keywords": [
    "kafka",
    "librdkafka"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:qiujie8092916/node-rdkafka.git"
  },
  "contributors": [
    {
      "name": "Stephen Parente",
      "email": "webmakersteve@gmail.com"
    },
    {
      "name": "Matt Gollob",
      "email": "mattness@users.noreply.github.com"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "aws-sdk": "^2.1691.0",
    "bluebird": "^3.5.3",
    "jsdoc": "^4.0.2",
    "jshint": "^2.10.1",
    "mocha": "^10.2.0",
    "node-gyp": "^10.1.0",
    "toolkit-jsdoc": "^1.0.0"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "^1.0.11",
    "bindings": "^1.3.1",
    "nan": "^2.19.0",
    "node-pre-gyp-github": "^2.0.0"
  },
  "engines": {
    "node": ">=16"
  },
  "binary": {
    "module_name": "node-rdkafka",
    "module_path": "./build/Release/",
    "remote_path": "{version}",
    "package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}.tar.gz",
    "host": "https://github.com/qiujie8092916/node-rdkafka/releases/download/"
  }
}
